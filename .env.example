# Copy this file to `.env` and edit. Everything is optional.

# ---- Database: sqlite (zero setup) or postgres
DB_ENGINE=sqlite
# DB_HOST=localhost
# DB_NAME=intrusiondb
# DB_USER=postgres
# DB_PASSWORD=your_password

# ---- Dashboard login (created by `python source/init_db.py`)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
SECRET_KEY=change-me

# ---- Demo mode: true = never touch iptables (safe on any laptop)
DEMO_MODE=true

# ---- AI provider: offline | gemini | openai
LLM_PROVIDER=offline

# Google Gemini (free key: https://aistudio.google.com)
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_key
# GEMINI_MODEL=gemini-2.5-flash

# Any OpenAI-compatible API (OpenAI, Groq, OpenRouter, local Ollama...)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_key
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile

# ---- Real sensor settings (only used by `sudo python source/main.py`)
# IDS_INTERFACE=enp0s8
# MONITORED_NETWORK=192.168.56.0/24
# IDS_HOST_IP=192.168.56.112

# ---- Incident grouping & auto triage
INCIDENT_WINDOW_MINUTES=10
AUTO_TRIAGE=true

# ---- P1 notifications (optional): Slack or Discord incoming webhook
# NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# PUBLIC_BASE_URL=http://127.0.0.1:5000

# ---- Access-log ingestion: IP of the web server the logs come from
# WEB_SERVER_IP=192.168.56.104
